DATABASE_URL=postgresql+psycopg://frame:frame@localhost:5432/frame
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
BASE_URL=http://localhost:8000
COOKIE_SECURE=false
ENVIRONMENT=development
INGEST_INTERVAL_MINUTES=15
HTTP_TIMEOUT=20
REQUEST_INTERVAL_SECONDS=3
DEDUP_AUTO_THRESHOLD=93
DEDUP_REVIEW_THRESHOLD=76
DEDUP_WINDOW_DAYS=7
SEMANTIC_ENABLED=false
# Local model directory only; downloading is an explicit setup step.
SEMANTIC_MODEL_PATH=
TMDB_API_KEY=
